{
  "name": "open-in-basic-window-browser-extension",
  "title": "Open in Basic Window",
  "version": "1.0.0",
  "description": "Open links, media, tabs, frames, and pages in a basic popup window.",
  "author": "Ryan Thaut <rthaut@gmail.com> (https://ryan.thaut.me)",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rthaut/open-in-basic-window-browser-extension.git"
  },
  "bugs": {
    "url": "https://github.com/rthaut/open-in-basic-window-browser-extension/issues"
  },
  "homepage": "https://github.com/rthaut/open-in-basic-window-browser-extension#readme",
  "keywords": [
    "browser-extension",
    "chrome-extension",
    "edge-extension",
    "firefox-extension",
    "webextension",
    "wxt"
  ],
  "private": true,
  "packageManager": "npm@11.11.0",
  "scripts": {
    "dev": "wxt",
    "dev:chrome": "wxt --browser chrome",
    "dev:edge": "wxt --browser edge",
    "dev:firefox": "wxt --browser firefox",
    "generate:icons": "node scripts/generate-icons.mjs",
    "check:icons": "node scripts/generate-icons.mjs --check",
    "generate:store-assets": "node scripts/generate-store-assets.mjs",
    "check:store-assets": "node scripts/generate-store-assets.mjs --check",
    "serve:screenshot-demo": "node scripts/serve-screenshot-demo.mjs",
    "build": "wxt build",
    "build:chrome": "wxt build --browser chrome",
    "build:edge": "wxt build --browser edge",
    "build:firefox": "wxt build --browser firefox",
    "zip": "wxt zip",
    "zip:chrome": "wxt zip --browser chrome",
    "zip:edge": "wxt zip --browser edge",
    "zip:firefox": "wxt zip --browser firefox",
    "format": "run-p format:source format:docs format:scripts format:actions",
    "format:check": "run-p format:source:check format:docs:check format:scripts:check format:actions:check",
    "format:source": "prettier --write \"entrypoints/**/*.{ts,mts,json}\" \"src/**/*.{ts,mts,json}\" \"tests/**/*.ts\"",
    "format:source:check": "prettier --check \"entrypoints/**/*.{ts,mts,json}\" \"src/**/*.{ts,mts,json}\" \"tests/**/*.ts\"",
    "format:docs": "prettier --write README.md \"docs/**/*.{md,html,css,js}\"",
    "format:docs:check": "prettier --check README.md \"docs/**/*.{md,html,css,js}\"",
    "format:scripts": "prettier --write package*.json .prettierrc.json eslint.config.mjs tsconfig.json wxt.config.ts \"scripts/**/*.{js,mjs,cjs,ts,mts}\"",
    "format:scripts:check": "prettier --check package*.json .prettierrc.json eslint.config.mjs tsconfig.json wxt.config.ts \"scripts/**/*.{js,mjs,cjs,ts,mts}\"",
    "format:actions": "prettier --write \".github/**/*.{yml,yaml}\"",
    "format:actions:check": "prettier --check \".github/**/*.{yml,yaml}\"",
    "lint": "run-p lint:source lint:docs lint:scripts lint:actions",
    "lint:source": "eslint entrypoints src tests",
    "lint:docs": "eslint docs/site/site.js",
    "lint:scripts": "eslint eslint.config.mjs wxt.config.ts scripts",
    "lint:actions": "github-actionlint -shellcheck= -pyflakes=",
    "compile": "wxt prepare && tsc --noEmit",
    "test": "vitest run --pool=threads"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.6.0",
    "github-actionlint": "^1.7.12",
    "globals": "^17.7.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.5",
    "sharp": "^0.35.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10",
    "wxt": "^0.20.27"
  }
}
